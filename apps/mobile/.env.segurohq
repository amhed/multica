# Mobile production env for the SeguroHQ self-hosted instance. Same
# `production` variant as .env.production (Carropana), with its own bundle id,
# name and icon so both personal copies install side by side. Build with:
#   pnpm ios:device:segurohq:release
EXPO_PUBLIC_API_URL=https://multica.segurohq.com
EXPO_PUBLIC_WEB_URL=https://multica.segurohq.com
EXPO_APP_NAME=SeguroHQ Multica
EXPO_BUNDLE_IDENTIFIER_PROD=ai.multica.mobile.segurohq
EXPO_APP_ICON=./assets/icon-segurohq.png
